{
  "name": "ringer-pwa",
  "version": "1.0.0",
  "description": "A horseshoe scoring app for the Reno Horseshoe League",
  "scripts": {
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JDTornado/ringer-pwa.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/JDTornado/ringer-pwa/issues"
  },
  "homepage": "https://github.com/JDTornado/ringer-pwa#readme",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "fake-indexeddb": "^6.2.7",
    "supabase": "^2.122.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "idb-keyval": "^6.3.0"
  }
}
